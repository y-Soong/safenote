# PRAFTA 백엔드 환경변수 템플릿
# - 실제 값은 .env (git 무시됨) 또는 OS/실행환경 환경변수로 주입한다.
# - 이 파일(.env.example)은 "어떤 변수가 필요한지"만 알려주는 커밋용 샘플이다(실값 금지).
# - Spring Boot 는 .env 파일을 자동으로 읽지 않는다. IDE 실행구성/도커 env_file/쉘 export 등으로
#   OS 환경변수에 올려야 application*.properties 의 ${...} 가 치환된다.

############################
# 필수 (기본값 없음 → 미설정 시 앱 기동 실패)
############################

# JWT 서명 시크릿 (충분히 긴 랜덤 문자열)
JWT_SECRET=

# 비밀번호 해싱용 pepper
SECURITY_PASSWORD_PEPPER=

# RefreshToken HMAC pepper
PRAFTA_REFRESH_TOKEN_PEPPER=

# PII AES-GCM 데이터 암호화 키 (Base64)
PRAFTA_AES_DATA_KEY=

# DB 비밀번호 (평문 커밋 금지 → 반드시 여기로만 주입)
DB_PASSWORD=

############################
# 선택 (미설정 시 application*.properties 의 기본값 사용)
############################

# DB 접속 URL (기본: 로컬 MySQL + p6spy)
# DB_URL=jdbc:p6spy:mysql://localhost:3306/prafta?serverTimezone=Asia/Seoul&useUnicode=true&characterEncoding=utf8&connectionCollation=utf8mb4_unicode_ci

# DB 사용자 (기본: dev_prafta)
# DB_USERNAME=dev_prafta

# 업로드 파일 루트 디렉토리 (기본: 실행 디렉토리/uploads)
# 운영 서버에서는 영속 볼륨 경로로 지정 권장.
# FILE_UPLOAD_BASE_DIR=/data/prafta/uploads

# 공휴일 API (공공데이터포털)
# HOLIDAY_API_BASE_URL=http://apis.data.go.kr/B090041/openapi/service/SpcdeInfoService/getRestDeInfo
# HOLIDAY_API_SERVICE_KEY=
# HOLIDAY_API_NUM_OF_ROWS=100
# HOLIDAY_API_TYPE=json

# FCM 공용 PUSH 전송 워커 (PRAFTA-COM-002, consumer)
# - FIREBASE_CREDENTIALS_PATH: FCM 서비스 계정 키 JSON '파일 경로' (키 원문/파일 절대 커밋 금지).
#   미설정(빈 값) 시 워커가 초기화하지 않고 조용히 skip(부팅 영향 0).
# - PUSH_WORKER_ENABLED: 워커 게이트(기본 false). 운영 검증 후 수동 true.
#   ★ true 로 켜기 전에 prafta-com-002-user-device-del-yn.sql 마이그를 반드시 선행 적용할 것. ★
# FIREBASE_CREDENTIALS_PATH=
# PUSH_WORKER_ENABLED=false
# PUSH_WORKER_INTERVAL_MS=30000
# PUSH_WORKER_BATCH_SIZE=50
# PUSH_WORKER_MAX_RETRY=3

############################
# 빌드 환경 (Spring 프로퍼티 아님 / 참고)
############################

# Gradle 실행 JVM 및 toolchain 탐지에 사용. JDK 21 경로로 설정.
# (gradle.properties 에서 하드코딩 제거됨 → 이 환경변수에 의존)
# JAVA_HOME=C:\Java\jdk-21.0.2
