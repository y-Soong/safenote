<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.prafta.app.terms.terms01.mapper.Terms01Mapper">

    <!-- ====================================================================
         미동의 필수약관 목록(앱 로그인 게이트).
         REQUIRED_YN='Y' AND USE_YN='Y' 인 약관 중, 해당 사용자가 현재버전을
         AGR_YN='Y' 로 동의하지 않은 약관만 반환한다.
         약관명은 TB_SYST_VAL_D(SYS008) SYST_VAL_D_NM(selectRequiredTermsList 패턴 동일).
         동의여부는 (USER_CD, TERMS_ID, 현재버전) AGR_YN='Y' 행 존재로 판정한다.
         ==================================================================== -->
    <select id="selectPendingRequiredTerms" resultType="com.prafta.app.terms.terms01.mapper.result.PendingTermsResult">
    /* Terms01Mapper.selectPendingRequiredTerms */
    SELECT
          B.TERMS_ID         AS termsId
        , S.SYST_VAL_D_NM    AS termsNm
        , B.TERMS_VERSION    AS termsVersion
        , B.TERMS_CONTENT    AS termsContent
    FROM TB_TERMS B
         INNER JOIN TB_SYST_VAL_D S
            ON (
                S.SYST_VAL_CD = 'SYS008'
            AND S.SYST_VAL_D_CD = B.TERMS_ID
            )
         LEFT OUTER JOIN TB_TERMS_USER_AGR_MGMT A
            ON (
                A.TERMS_ID = B.TERMS_ID
            AND A.TERMS_VERSION = B.TERMS_VERSION
            AND A.CMPNY_CD = #{cmpnyCd}
            AND A.USER_CD = #{userCd}
            AND A.AGR_YN = 'Y'
            )
    WHERE 1=1
      AND B.REQUIRED_YN = 'Y'
      AND B.USE_YN = 'Y'
      AND A.USER_CD IS NULL
    </select>

    <!-- ====================================================================
         ★ 선택약관 목록(selectOptionalTerms) / 현재버전 resolve(selectOptionalTermsCurrentVersion)는
           본 매퍼에서 제거되고 ConsentMapper(common/cmm/consent)로 이관되었다.
           웹 내 정보 팝업(제3자 제공 동의 토글)이 같은 구문을 써야 하는데, 앱·웹이 각자 복사본을
           들고 있으면 술어(REQUIRED_YN/USE_YN)가 갈려 채널별로 노출 약관이 달라진다.
           앱 서비스(Terms01ServiceImpl)는 ConsentTermsService 를 경유하며 응답 스펙은 불변이다.
         ==================================================================== -->

    <!-- ====================================================================
         ★ SUBCON-T4: 약관 동의 upsert(upsertTermsAgr)는 본 매퍼에서 제거되고
           ConsentMapper.upsertTermsAgr 로 일원화되었다(common/cmm/consent).
           동의 변경은 반드시 ConsentHistoryRecorder.recordAndUpsert 를 경유해야 하며,
           이력(TB_TERMS_USER_AGR_HIST)을 남기지 않는 우회 경로를 두지 않는다(plan §2 T4-03).
         ==================================================================== -->

</mapper>
