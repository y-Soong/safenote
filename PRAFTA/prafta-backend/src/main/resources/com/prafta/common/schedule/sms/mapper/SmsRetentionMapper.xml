<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.prafta.common.schedule.sms.mapper.SmsRetentionMapper">

    <!-- ============================================================
         [4차 / sec T-11 · T-3] SMS 인증 관련 보존기간 정리(purge)

         ★삭제는 배치 LIMIT 로 나눈다. 한 문장으로 대량 삭제하면 긴 트랜잭션 + 넓은 갭락으로
           인증 흐름 전체(발송 가드의 정책행 직렬화 포함)가 그 뒤에 줄을 선다.
         ★기준 컬럼은 둘 다 INSERT_DATE 다. 상한 판정 최대 구간이 1일, 화면 통계가 24시간이라
           보존일수(기본 90일) 안쪽에서 삭제가 판정/표시에 영향을 주지 않는다.
         ============================================================ -->

    <!-- 검증 시도 로그 정리. idx_sms_verify_ins(INSERT_DATE) 인덱스 정합
         - 이 인덱스가 없으면 풀스캔이 되므로 4차 DDL 에서 함께 추가했다. -->
    <delete id="deleteOldVerifyAttempts">
    /* SmsRetentionMapper.deleteOldVerifyAttempts */
    DELETE FROM TB_SMS_VERIFY_ATTEMPT
    WHERE INSERT_DATE <![CDATA[ < ]]> DATE_SUB(NOW(), INTERVAL #{retentionDays} DAY)
    LIMIT #{batchSize}
    </delete>

    <!-- 인증코드 정리.
         ★VERIFIED_YN / SEND_STATUS 를 조건에 넣지 않는다 - 90일이 지난 행은 상태와 무관하게
           어떤 판정에도 쓰이지 않는다. 조건을 붙이면 특정 상태의 행만 영구히 남는다.
         idx_sms_auth_mbl_hmac_ins 등 INSERT_DATE 를 포함한 인덱스가 이미 존재한다. -->
    <delete id="deleteOldAuthCodes">
    /* SmsRetentionMapper.deleteOldAuthCodes */
    DELETE FROM TB_SMS_AUTH_CODE
    WHERE INSERT_DATE <![CDATA[ < ]]> DATE_SUB(NOW(), INTERVAL #{retentionDays} DAY)
    LIMIT #{batchSize}
    </delete>

</mapper>
